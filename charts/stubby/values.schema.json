{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "additionalProperties": true,
  "required": ["image", "dummyImages", "tls"],
  "properties": {
    "tls": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "enum": ["self-signed", "cert-manager"] }
      }
    }
  }
}
